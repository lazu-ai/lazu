# Personal / per-developer scratch — ad-hoc test scripts, scratch SQL,
# local notes. Distinct from .local-results/ (which holds tool-produced
# artifacts that get overwritten); local/ is hand-written source you
# don't want to share with the team.
local/

apps/docs-mintlify/.mintlify/
apps/docs-mintlify/node_modules/

# Claude Code per-developer IDE config (preview server launch, etc.)
.claude/launch.json
**/.claude/launch.json
# Claude Code per-developer permissions and machine-local settings
.claude/settings.local.json
**/.claude/settings.local.json
# Claude Code scheduled-task runtime lock (sessionId + pid, regenerated each run)
.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.lock

