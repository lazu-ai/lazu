# Lazu local / self-hosted Docker stack (platform/docker/docker-compose.yml).
# Copy to .env, set the passwords, then start with:
#   docker compose --env-file .env -f platform/docker/docker-compose.yml up --build -d
# Every value below may stay empty for a first local try.

# Console administrator created on first start. An empty password falls back
# to the compose file's local default (change-me-local-root), which is only
# fit for a first try on your own machine.
ROOT_USERNAME=root
ROOT_PASSWORD=

# Bundled PostgreSQL (Core and Telemetry stores) and Redis. Empty values use
# the compose file's local defaults; set strong ones before the first start
# of anything others can reach, because they are baked into the volumes.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Proxies whose X-Forwarded-For the gateway trusts. Keep the frontend's
# address (172.28.0.10) when the bundled frontend fronts the API.
TRUSTED_PROXY_CIDRS=127.0.0.1/8,::1/128,172.28.0.10/32

# First start creates the schema and opens the financial ledger; later starts
# do nothing. Set to false only if you run `/migrate` yourself.
LAZU_RUN_MIGRATIONS_ON_START=true
LAZU_BOOTSTRAP_LEDGER_ON_START=true

# --- Optional integrations ------------------------------------------------
# These reach the containers only through
# platform/docker/docker-compose.integrations.example.yml (see the README).
# Leave any of them empty and that feature stays off.

# Where people reach your console; used in mail and payment links.
FRONTEND_BASE_URL=
# Required for multi-replica deployments; any long random strings.
SESSION_SECRET=
CRYPTO_SECRET=
# Mail through Resend, or SMTP in config/backend/config.yaml.
RESEND_API_KEY=
ADMIN_EMAIL=
# Telegram bot (create it with @BotFather). TELEGRAM_OPS_CHAT gets a copy of
# every operational alert: a chat id, optionally :<topic id> in a forum group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPS_CHAT=
# Card top-ups through Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# S3-compatible object storage for the Files API and request captures.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
