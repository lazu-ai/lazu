    "tailwindcss": "^3",
    "terser": "5.51.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.4.5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "brace-expansion": "5.0.11",
