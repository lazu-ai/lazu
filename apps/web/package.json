  "scripts": {
    "dev": "bun run brand:sync && vite",
    "build": "bun run brand:sync && bun scripts/generate-seo-assets.mjs && vite build && bun scripts/generate-static-pages.mjs && bun run check:prerender",
    "build:spa": "vite build",
    "test:smoke": "playwright test --config=playwright.config.ts",
    "test:unit": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "prettier . --check",
    "lint:fix": "prettier . --write",
    "eslint": "bunx eslint \"**/*.{ts,tsx,cts}\" --cache --max-warnings 0",
    "eslint:fix": "bunx eslint \"**/*.{ts,tsx,cts}\" --fix --cache",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "preview": "vite preview",
    "size": "bun scripts/check-bundle-size.mjs",
    "analyze": "bun run build && open dist/stats.html",
    "i18n:check": "python3 scripts/audit_frontend_debt.py --only i18n --check",
    "i18n:extract": "bunx i18next-cli extract",
    "i18n:status": "bunx i18next-cli status",
    "i18n:sync": "bunx i18next-cli sync",
    "i18n:lint": "bunx i18next-cli lint",
    "brand:sync": "bun scripts/sync-brand-tokens.mjs",
    "brand:check": "bun scripts/sync-brand-tokens.mjs --check && bun scripts/check-brand-contract.mjs",
    "check:prerender": "bun scripts/check-prerender-output.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@so1ve/prettier-config": "^3.1.0",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^25.6.2",
