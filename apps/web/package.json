    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "braces": "file:./vendor/braces",
    "eslint": "^9.39.1",
    "eslint-plugin-header": "^3.1.1",
