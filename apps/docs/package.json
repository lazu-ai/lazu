{
  "name": "lazu-docs",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "sync:openapi": "node --import jiti/register scripts/sync-openapi.ts",
    "predev": "npm run brand:sync && npm run sync:openapi",
    "prebuild": "npm run brand:sync && npm run sync:openapi",
    "postbuild": "node --import jiti/register scripts/postbuild-geo.ts && node --import jiti/register scripts/postbuild-404.ts",
    "build": "mkdir -p ../../.local-results/docs-build && NODE_OPTIONS=--localstorage-file=../../.local-results/docs-build/node-localstorage vocs build",
    "dev": "vocs --host 0.0.0.0",
    "preview": "vocs preview",
    "start": "vocs preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "brand:sync": "node scripts/sync-brand-tokens.mjs",
    "brand:check": "node scripts/sync-brand-tokens.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@scalar/api-reference-react": "^0.8.70",
    "lucide-react": "^0.511.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.15.1",
    "vocs": "^1.4.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  }
}
